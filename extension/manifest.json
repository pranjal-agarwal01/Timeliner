{
    "manifest_version": 3,
    "name": "DSA Tracker - Auto Import",
    "version": "1.0.0",
    "description": "Auto-import DSA questions from LeetCode and GeeksforGeeks into your DSA Revision Tracker",
    "permissions": [
        "storage",
        "activeTab"
    ],
    "host_permissions": [
        "https://leetcode.com/*",
        "https://www.geeksforgeeks.org/*",
        "https://*/*"
    ],
    "background": {
        "service_worker": "background.js"
    },
    "action": {
        "default_popup": "popup.html",
        "default_icon": {
            "16": "icons/icon16.png",
            "48": "icons/icon48.png",
            "128": "icons/icon128.png"
        }
    },
    "content_scripts": [
        {
            "matches": [
                "https://leetcode.com/problems/*"
            ],
            "js": [
                "content-leetcode.js"
            ],
            "css": [
                "content-styles.css"
            ],
            "run_at": "document_idle"
        },
        {
            "matches": [
                "https://www.geeksforgeeks.org/problems/*",
                "https://practice.geeksforgeeks.org/problems/*"
            ],
            "js": [
                "content-gfg.js"
            ],
            "css": [
                "content-styles.css"
            ],
            "run_at": "document_idle"
        }
    ],
    "icons": {
        "16": "icons/icon16.png",
        "48": "icons/icon48.png",
        "128": "icons/icon128.png"
    }
}