# Server Environment Variables
# Copy this to .env and fill in the values

# MongoDB Atlas connection string
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?appName=<AppName>

# JWT
JWT_SECRET=<generate a strong random secret>
JWT_EXPIRES_IN=7d

# SMTP (Gmail App Password recommended)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your@gmail.com
SMTP_PASS=<gmail-app-password>
SMTP_FROM=Timeliner <your@gmail.com>

# Allowed frontend origins — comma-separated for multiple Vercel URLs
# e.g. https://timeliner.vercel.app,https://timeliner-git-main-user.vercel.app
CLIENT_ORIGIN=http://localhost:5173

# Server
NODE_ENV=development
PORT=5000
